{
  "name": "playrecap-private",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-20",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "AUDIO",
      "bucket_name": "playrecap-private-audio"
    }
  ],
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "1921092101",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
